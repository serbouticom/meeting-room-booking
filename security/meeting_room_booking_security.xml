<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_meeting_room_booking" model="ir.module.category">
        <field name="name">Meeting Rooms</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_meeting_room_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_meeting_room_booking"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_meeting_room_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_meeting_room_booking"/>
        <field name="implied_ids" eval="[(4, ref('group_meeting_room_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="meeting_room_booking_rule_read_all" model="ir.rule">
        <field name="name">Meeting Room Booking: read all</field>
        <field name="model_id" ref="model_meeting_room_booking"/>
        <field name="groups" eval="[(4, ref('group_meeting_room_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="meeting_room_booking_rule_own" model="ir.rule">
        <field name="name">Meeting Room Booking: manage own</field>
        <field name="model_id" ref="model_meeting_room_booking"/>
        <field name="groups" eval="[(4, ref('group_meeting_room_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('room_id.responsible_id', '=', user.id)]</field>
    </record>

    <record id="meeting_room_booking_rule_manager" model="ir.rule">
        <field name="name">Meeting Room Booking: manager full access</field>
        <field name="model_id" ref="model_meeting_room_booking"/>
        <field name="groups" eval="[(4, ref('group_meeting_room_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="meeting_room_booking_rule_company" model="ir.rule">
        <field name="name">Meeting Room Booking: multi-company</field>
        <field name="model_id" ref="model_meeting_room_booking"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="meeting_room_rule_company" model="ir.rule">
        <field name="name">Meeting Room: multi-company</field>
        <field name="model_id" ref="model_meeting_room"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
